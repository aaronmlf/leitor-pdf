{
  "name": "leitor",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "onnxruntime-web": "1.18.0"
  },
  "scripts": {
    "dev": "npm run dev -w @leitor/web",
    "build": "npm run build -w @leitor/web",
    "preview": "npm run preview -w @leitor/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "desktop": "npm run dev -w @leitor/desktop --",
    "desktop:build": "npm run build -w @leitor/desktop --",
    "android:sync": "npm run cap:sync -w @leitor/web",
    "android:open": "npm run cap:open -w @leitor/web",
    "fixture": "node scripts/make-fixture.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
