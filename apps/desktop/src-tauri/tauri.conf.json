{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Leitor",
  "version": "1.1.0",
  "identifier": "br.leitor.app",
  "build": {
    "beforeDevCommand": "npm run dev -w @leitor/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build -w @leitor/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Leitor — livros em voz alta",
        "width": 1020,
        "height": 760,
        "minWidth": 380,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
